<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ControlFinance.API</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core + PostgreSQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore"                  Version="8.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"           Version="8.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"          Version="8.0.4" />

    <!-- JWT Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.4" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens"                Version="7.5.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt"               Version="7.5.1" />

    <!-- Data Protection: guarda o key ring usado pra assinar os cookies CSRF (IAntiforgery)
         no Postgres, senão cada reinício/redeploy trocaria a chave e invalidaria os tokens. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="8.0.4" />

    <!-- Bcrypt para hash de senha -->
    <PackageReference Include="BCrypt.Net-Next"                               Version="4.0.3" />

    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore"                        Version="6.6.2" />

    <!-- Pins diretos de dependências transitivas vulneráveis (GHSA-qj66-m88j-hmgj,
         GHSA-hh2w-p6rv-4g7w, GHSA-8g4q-xg66-9fp4): sem isso, o resolver do NuGet trazia
         versões antigas dessas duas bibliotecas mesmo sem nenhum PackageReference explícito
         pra elas. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory"           Version="8.0.1" />
    <PackageReference Include="System.Text.Json"                              Version="8.0.6" />

    <!-- Mesmo motivo dos dois pins acima: Microsoft.AspNetCore.DataProtection (usado pro key
         ring do CSRF/antiforgery) traz System.Security.Cryptography.Xml 8.0.0 transitivamente,
         que por sua vez traz System.Formats.Asn1 8.0.0, ambos com CVEs High conhecidos
         (GHSA-447r-wph3-92pm no Asn1; vários no Cryptography.Xml, incl. GHSA-37gx-xxp4-5rgx).
         Últimas versões 8.0.x disponíveis no momento do pin. -->
    <PackageReference Include="System.Security.Cryptography.Xml"              Version="8.0.4" />
    <PackageReference Include="System.Formats.Asn1"                           Version="8.0.2" />
  </ItemGroup>

</Project>
