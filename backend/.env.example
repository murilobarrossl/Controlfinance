# =====================================================
#  CONTROL FINANCE - variáveis de ambiente
#  NUNCA commite este arquivo no git!
#  Adicione .env ao .gitignore
# =====================================================

# Banco de dados
ConnectionStrings__DefaultConnection=Host=SEU_HOST;Port=5432;Database=controlfinance;Username=postgres;Password=SUA_SENHA

# JWT
JwtSettings__SecretKey=GERE_UMA_CHAVE_FORTE_AQUI_MINIMO_32_CHARS
JwtSettings__Issuer=ControlFinance.API
JwtSettings__Audience=ControlFinance.Client
JwtSettings__ExpiresInHours=8

# Cookie de sessão: Lax quando frontend e API estão no mesmo domínio registrável
# (ex.: app.seudominio.com.br e api.seudominio.com.br). None só se estiverem em domínios
# diferentes (navegadores que bloqueiam cookie de terceiro vão impedir o login nesse caso).
Auth__CookieSameSite=Lax

# AES-256 - criptografia dos dados sensíveis
# Encryption__Key: segredo legado. Continua obrigatório enquanto houver dado gravado no formato
# antigo (sem prefixo "cfk:"/"cfh:").
Encryption__Key=GERE_OUTRA_CHAVE_FORTE_AQUI_QUALQUER_TEXTO_LONGO
# Anel de chaves versionado (opcional, recomendado). Segredos com 32+ caracteres aleatórios,
# DIFERENTES entre si e do Encryption__Key. Cifragem e hash de busca (CPF) usam segredos
# independentes: o vazamento de um não expõe o outro. Ver relatório, Parte H.1.
# Encryption__Keys__k2026a=SEGREDO_DE_CIFRAGEM_ALEATORIO_32_OU_MAIS_CARACTERES
# Encryption__ActiveKeyId=k2026a
# Encryption__LookupKeys__h2026a=SEGREDO_DO_HASH_DE_BUSCA_ALEATORIO_32_OU_MAIS_CARACTERES
# Encryption__ActiveLookupKeyId=h2026a
# Encryption__RotateOnStartup=false   # true só durante uma troca de chave

# Retenção (opt-in; apagar dado é irreversível). Vazio = sem prazo.
# DataRetention__SyncedHistoryMonths=24

# Registro de acesso (Marco Civil art. 15). Off por padrão; ver relatório, Parte H.8.
AccessLog__Mode=Off
AccessLog__RetentionDays=183

# Polp (API v2 / Celcoin). Produção: https://api.polp.com.br/api/v2
# Testes: https://api.polp.com.br/api/v2/sandbox (dados fictícios; nunca com dados reais)
Polp__BaseUrl=https://api.polp.com.br/api/v2
Polp__ClientId=
Polp__ClientSecret=
# Opcional: para onde o banco devolve o usuário depois de autorizar
Polp__RedirectUrl=
# Segredo do caminho do webhook cadastrado no Dashboard da Polp:
#   https://SEU-BACKEND/api/polp/webhook/<Polp__WebhookToken>
# Mínimo 32 caracteres aleatórios (ex.: openssl rand -hex 32). Para trocar sem perder eventos,
# coloque o token antigo em Polp__WebhookTokenPrevious até a Polp passar a usar o novo.
Polp__WebhookToken=
Polp__WebhookTokenPrevious=

# Resend - emails transacionais
# Obtenha em: https://resend.com/api-keys
Resend__ApiKey=re_XXXXXXXXXXXXXXXXXXXXXXXX
Resend__FromEmail=noreply@seudominio.com.br
Resend__FromName=Control Finance
